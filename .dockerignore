# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyc
*$py.class

# Build artifacts (this excludes .tar.gz and other dist files)
dist/
build/
*.egg-info/
*.tar.gz
*.tar
*.whl

# Logs directory contents (keep the empty folder if needed, but no data)
logs/*
!logs/.gitkeep # optional: create an empty .gitkeep file if you want the folder

# IDE and local files
.idea/
.vscode/
.git/
.env
venv/
.env*

# Optional: other junk
*.swp
*.swo
.DS_Store

